{
  "modules": [
    {
      "type": "registry",
      "name": "viam_detections-to-segments",
      "module_id": "viam:detections-to-segments",
      "version": "1.3.1"
    }
  ],
  "services": [
    {
      "name": "carton-detector",
      "api": "rdk:service:vision",
      "model": "color_detector",
      "attributes": {
        "camera_name": "cam",
        "detect_color": "#1C4599",
        "hue_tolerance_pct": 0.1,
        "segment_size_px": 500,
        "saturation_cutoff_pct": 0.3,
        "value_cutoff_pct": 0.1,
        "label": "blue"
      }
    },
    {
      "name": "vision-segment",
      "api": "rdk:service:vision",
      "model": "viam:vision:detections-to-segments",
      "attributes": {
        "camera_name": "cam",
        "detector_name": "carton-detector",
        "mean_k": 5,
        "sigma": 1.25
      }
    }
  ]
}
